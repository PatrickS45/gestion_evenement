{
  "name": "event-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build && node scripts/build-hooks.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:charge": "vitest run --mode charge --silent=false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "server": "node scripts/pocketbase.mjs serve",
    "server:install": "node scripts/pocketbase.mjs install",
    "build:hooks": "node scripts/build-hooks.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "barcode-detector": "^3.2.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.58.0",
    "pocketbase": "^0.28.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eventsource": "^5.1.2",
    "rolldown": "^1.2.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
